JARVIS_OLLAMA_URL=http://localhost:11434
JARVIS_MODEL=qwen2.5:7b
JARVIS_HOME_DIR=~
JARVIS_MAX_SEARCH_RESULTS=15
JARVIS_MAX_TOOL_ITERATIONS=8
JARVIS_OLLAMA_TIMEOUT=120
JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8
JARVIS_WAKE_WORD_THRESHOLD=0.5
JARVIS_RECORD_SECONDS=6
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_PASSWORD=
JARVIS_MUSIC_PLAYER=
# Compatibilidad opcional para aplicaciones antiguas sin entrada .desktop.
JARVIS_ALLOWED_APPS=firefox,code,nautilus,spotify,steam,gedit,gnome-terminal,thunderbird,vlc,discord,chrome,chromium,brave
# Voz adaptativa (VAD simple por energía)
JARVIS_VOICE_MAX_SECONDS=20
JARVIS_VOICE_SILENCE_SECONDS=1.0
JARVIS_VOICE_RMS_THRESHOLD=0.015
JARVIS_VOICE_BLOCK_MS=30
JARVIS_VOICE_PRE_ROLL_MS=240

# Memoria y productividad
JARVIS_MEMORY_AUTO_SAVE=false
JARVIS_REMINDER_POLL_SECONDS=15
# Opcional para control de ventanas: instalar wmctrl

# Contexto persistente
JARVIS_MEMORY_CONTEXT_RECALL=true
JARVIS_MEMORY_CONTEXT_MAX_RECALLS=8
